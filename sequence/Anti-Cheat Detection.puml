@startuml anti_cheat_sequence
title Sequence Diagram - Anti-Cheat Detection

actor Student
participant TestController
participant TestService
participant AntiCheatService
participant TestAttemptRepository
participant EventLogRepository
database DB

Student -> TestController: startTest(user_id, test_id)
TestController -> TestService: createAttempt(user_id, test_id)
TestService -> TestAttemptRepository: insertAttempt(user_id, test_id)
TestAttemptRepository -> DB: INSERT test_attempt
TestService --> TestController: attempt_id

' ===== During Test =====
loop every 5 seconds
    Student -> TestController: detectActivity()
    
    TestController -> AntiCheatService: checkActivity(attempt_id)
    
    alt Tab Switched
        AntiCheatService -> EventLogRepository: logSuspiciousActivity(attempt_id, tab_switch)
        EventLogRepository -> DB: INSERT event_log
        AntiCheatService --> TestController: warning
    end
    
    alt Copy Detected
        AntiCheatService -> EventLogRepository: logSuspiciousActivity(attempt_id, copy_attempt)
        EventLogRepository -> DB: INSERT event_log
        AntiCheatService --> TestController: warning
    end
    
    TestController --> Student: {warning}
end

' ===== On Submit =====
Student -> TestController: submitTest(attempt_id, answers)
TestController -> TestService: submitTest(attempt_id, answers)

TestService -> EventLogRepository: getActivityLog(attempt_id)
EventLogRepository -> DB: SELECT event_log
DB --> EventLogRepository: activity_log
EventLogRepository --> TestService: activity_log

TestService -> AntiCheatService: analyzeRiskScore(activity_log)
AntiCheatService -> AntiCheatService: calculateRiskScore()

alt risk_score > threshold
    AntiCheatService --> TestService: FLAGGED_FOR_REVIEW
    TestService -> TestAttemptRepository: updateAttemptStatus(attempt_id, flagged)
    TestAttemptRepository -> DB: UPDATE test_attempt
else risk_score <= threshold
    AntiCheatService --> TestService: OK
end

TestService --> TestController: result

@enduml
